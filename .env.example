# last30days Configuration
# Copy this to ~/.config/last30days/.env and fill in your values
# All keys are optional - the skill works with free sources by default

# =============================================================================
# CORE API KEYS (recommended for full functionality)
# =============================================================================

# X/Twitter search - pick ONE method:
# Option 1: Auto-detect browser cookies (easiest, free)
FROM_BROWSER=auto

# Option 2: Paste cookies manually from x.com (F12 > Application > Cookies)
# AUTH_TOKEN=your_auth_token_here
# CT0=your_ct0_token_here

# Option 3: Use xAI/Grok API
# XAI_API_KEY=your_xai_api_key_here

# Reddit comments + TikTok + Instagram (100 free calls, no credit card)
# Get key at: https://scrapecreators.com
# SCRAPECREATORS_API_KEY=your_scrapecreators_key_here

# =============================================================================
# BONUS SOURCES
# =============================================================================

# Bluesky social
# BSKY_HANDLE=your.bsky.social
# BSKY_APP_PASSWORD=your_app_password

# GitHub API (5K requests/hour vs 60 without token)
# Create token at: https://github.com/settings/tokens (no scopes needed)
# GITHUB_TOKEN=your_github_token_here

# Truth Social
# TRUTHSOCIAL_TOKEN=your_truth_social_token_here

# Web search (choose one or more)
# EXA_API_KEY=your_exa_key          # 1K free/month, semantic search
# BRAVE_API_KEY=your_brave_key      # Brave search
# OPENROUTER_API_KEY=your_openrouter_key  # Perplexity Sonar Pro

# =============================================================================
# BEHAVIOR SETTINGS
# =============================================================================

# Force additional sources on every run (comma-separated)
# INCLUDE_SOURCES=tiktok,instagram,github

# YouTube model settings
# OPENAI_MODEL_POLICY=auto    # auto, latest, or specific model
# XAI_MODEL_POLICY=latest     # latest or specific model

# =============================================================================
# SETUP COMPLETE (don't remove this line)
# =============================================================================
SETUP_COMPLETE=true
